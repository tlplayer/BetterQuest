import hash
import regex

def remove_parenthetical_suffixes(value: string) -> string:
    output := ""
    index := 0
    while index < size(value):
        if value[index] == "(":
            while size(output) > 0 and output.ends_with(" "):
                output = output[0:-1]
            index += 1
            while index < size(value) and value[index] != ")":
                index += 1
            if index < size(value):
                index += 1
        else:
            output += value[index]
            index += 1
    return output

def normalize_name(name: string) -> string:
    return remove_parenthetical_suffixes(name).trim_prefix("\\").strip().remove("’\"'")

def is_short_sound_line(line: string) -> bool:
    stripped = line.strip()
    if size(stripped) == 0:
        return false
    letters := 0
    for character in stripped.lower().characters():
        if character.is_alpha():
            letters += 1
        else character != "." and character != "!" and character != "?" and character != "…":
            return false
    return letters >= 1 and letters <= 4

def remove_audio_cues(text: string) -> string:
    cleaned = regex.sub("\\[[^]]*\\]|\\([^)]*\\)|<[^>]*>|\\*[^*]*\\*", "", text)
    return "\n".join(cleaned.split_lines().filter(|line| not is_audio_cue_line(line)))

def is_audio_cue_line(line: string) -> bool:
    lowered = line.strip().lower()
    return lowered.starts_with("sfx:") or lowered.starts_with("audio:") or lowered.starts_with("sound:") or is_short_sound_line(line)

def replace_gender_token(text: string) -> string:
    output := ""
    index := 0
    while index < size(text):
        if index + 1 < size(text) and text[index] == "$" and text[index + 1].lower() == "g":
            output += "adventurer"
            index += 2
            while index < size(text) and text[index] != ";":
                index += 1
            if index < size(text):
                index += 1
        else:
            output += text[index]
            index += 1
    return output

def is_boundary(character: string) -> bool:
    return character == " " or character == "\t" or character == "\r" or character == "\n" or character == "." or character == "?" or character == "!" or character == ";"

def replace_lad_lass_token(text: string) -> string:
    output := ""
    index := 0
    while index < size(text):
        tail = text[index:].lower()
        token_size := 0
        if tail.starts_with("$lass"):
            token_size = 5
        else tail.starts_with("$lad"):
            token_size = 4
        if token_size > 0 and (index + token_size == size(text) or is_boundary(text[index + token_size])):
            output += "adventurer"
            index += token_size
            while index < size(text) and text[index] != "." and text[index] != "?" and text[index] != "!" and text[index] != ";" and text[index] != "\n":
                index += 1
        else:
            output += text[index]
            index += 1
    return output

def replace_wow_tokens(text: string) -> string:
    output := ""
    index := 0
    while index < size(text):
        if text[index] == "$" and index + 1 < size(text):
            token = text[index + 1].lower()
            if token == "n" or token == "r" or token == "c":
                output += "adventurer"
                index += 2
            else:
                index += 2
                while index < size(text) and text[index].is_word():
                    index += 1
        else:
            output += text[index]
            index += 1
    return output

def collapse_blank_lines(text: string) -> string:
    output := text
    while output.find("\n\n\n") >= 0:
        output = output.replace("\n\n\n", "\n\n")
    return output

def normalize_dialog_text(text: string) -> string:
    normalized := text.replace("$B", "\n").replace("$b", "\n")
    normalized = remove_audio_cues(normalized)
    normalized = replace_lad_lass_token(normalized)
    normalized = replace_gender_token(normalized)
    normalized = replace_wow_tokens(normalized)
    return collapse_blank_lines(normalized.collapse_horizontal_space()).strip()

def normalize_text_for_matching(text: string) -> string:
    normalized = normalize_dialog_text(text).lower().replace("\n", " ")
    output := ""
    for character in normalized.characters():
        if character.is_word() or character == " ":
            output += character
        else:
            output += " "
    return output.collapse_space()

def create_text_hash(text: string) -> string:
    normalized = normalize_text_for_matching(text)
    if size(normalized) <= 50:
        return normalized
    return normalized[0:50]

def create_dialog_signature(text: string, race: string, sex: string) -> string:
    signature = text.strip() + "|" + (race if size(race) > 0 else "unknown") + "|" + (sex if size(sex) > 0 else "unknown")
    return hash.md5(signature)[0:16]

test "names match Python behavior":
    assert(normalize_name("  Thrall (Warchief)  ") == "Thrall")
    assert(normalize_name("\\Jaina’s \"Image\"") == "Jainas Image")

test "dialog normalization handles cues and every WoW token class":
    value = normalize_dialog_text("<Thrall laughs.> Honor, $N.$B$GHe:She; stands ready.")
    assert(value == "Honor, adventurer.\nadventurer stands ready.")
    assert(normalize_dialog_text("[bell] $lad of Stormwind, report!") == "adventurer!")
    assert(create_text_hash("Hello, HERO!!!") == "hello hero")

test "dialog signatures are Python-compatible MD5 prefixes":
    assert(create_dialog_signature("Hello", "human", "male") == "1fd8e3e78b65e5ce")
