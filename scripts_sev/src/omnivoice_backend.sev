import "src/domain.sev" as domain
import "src/utils.sev" as utils

native("system") def system(command: string) -> int

def buildCommand(request: domain.GenerationRequest) -> string:
    command := "PYENV_VERSION=betterquest /home/tplayer/.pyenv/shims/omnivoice-infer"
    command += " --text " + utils.shellQuote(request.text)
    command += " --output " + utils.shellQuote(request.outputPath)
    command += " --ref_audio " + utils.shellQuote(request.referenceAudio)
    command += " --ref_text " + utils.shellQuote(request.referenceText)
    command += " --language " + utils.shellQuote(request.language)
    command += " --num_step " + string(request.steps)
    command += " --device " + utils.shellQuote(request.device)
    command += " --position_temperature 0"
    command += " --class_temperature 0"
    return command

def ensureDirectory(path: string) -> int:
    return system("mkdir -p " + utils.shellQuote(path))

def stageFirstNpcRow(sourcePath: string, destinationPath: string, npcName: string) -> int:
    command := "head -n 1 " + utils.shellQuote(sourcePath) + " > " + utils.shellQuote(destinationPath)
    command += "; grep -m 1 " + utils.shellQuote("^" + npcName + ",") + " " + utils.shellQuote(sourcePath) + " >> " + utils.shellQuote(destinationPath)
    return system(command)

def generate(request: domain.GenerationRequest) -> int:
    return system(buildCommand(request))

test "OmniVoice command carries every typed request field":
    request = domain.GenerationRequest("Thrall", "orc", "Lok'tar, friend.", "samples/orc.wav", "Everything the light touches is our kingdom.", "output/thrall.wav", "English", 4, "cpu")
    command = buildCommand(request)
    assert(command.find("omnivoice-infer") >= 0)
    assert(command.find("--ref_audio 'samples/orc.wav'") >= 0)
    assert(command.find("--ref_text 'Everything the light touches is our kingdom.'") >= 0)
    assert(command.find("--num_step 4") >= 0)
    assert(command.find("--device 'cpu'") >= 0)
    assert(command.find("--position_temperature 0") >= 0)
    assert(command.find("--class_temperature 0") >= 0)
    assert(command.find("'Lok'\"'\"'tar, friend.'") >= 0)
