from file import write_text
import csv
import data
import file
import mysql
import os
import path
import "src/dialog_data.sev" as dialog_data
import "src/domain.sev" as domain

def excluded_substrings() -> list[string]:
    return [
        "attempts to run away in fear",
        "goes into a berserker rage",
        "is possessed",
        "is enraged",
        "begins to cast",
        "reuse me",
        "dies.",
        "flees in terror",
        "becomes enraged",
        "goes into a frenzy",
        "%s ",
    ]

def default_config() -> domain.ExtractionConfig:
    return domain.ExtractionConfig(
        "localhost",
        "mangos",
        "mangos",
        "classicmangos",
        3306,
        "../data/all_npc_dialog.csv",
        "../data/unknown_dialog_investigation.csv",
    )

def is_clean_text(text: string) -> bool:
    candidate = text.strip().lower()
    if size(candidate) == 0:
        return false
    for excluded in excluded_substrings():
        if candidate.find(excluded) >= 0:
            return false
    return true

def choose_text(primary: string, alternate: string) -> string:
    if is_clean_text(primary):
        return primary.strip()
    return alternate.strip() if is_clean_text(alternate) else ""

def query_or_empty(connection: Database, statement: string) -> list[list[string]]:
    switch mysql.query(connection, statement):
        ok rows:
            return rows
        failure error:
            print("[EXTRACT] Query failed:", error)
            return []

def npc_metadata(connection: Database) -> map[string, domain.NpcMetadata]:
    metadata := {}
    rows = query_or_empty(connection, "SELECT CAST(ct.Entry AS CHAR), ct.Name, COALESCE(CAST(cmi.gender AS CHAR), ''), COALESCE(CAST(ct.DisplayId1 AS CHAR), '') FROM creature_template ct LEFT JOIN creature_model_info cmi ON cmi.modelid = ct.DisplayId1")
    for row in rows:
        if size(row) >= 4:
            metadata[row[0]] = domain.NpcMetadata(row[1], "", row[2], "", row[3])
    return metadata

def make_dialog(npc_name: string, sex: string, dialog_type: string, quest_id: string, text: string) -> domain.Dialog:
    return domain.dialog(npc_name, sex, "", "vanilla", "1.12.1", dialog_type, quest_id, text.strip())

def known_npc(metadata: map[string, domain.NpcMetadata], npc_id: string, fallback: string) -> domain.NpcMetadata:
    if size(npc_id) > 0:
        value = metadata.get(npc_id, domain.NpcMetadata("", "", "", "", ""))
        if size(value.name) > 0:
            return value
    return domain.NpcMetadata(fallback, "", "", "", "")

def extract_attributed_broadcasts(
    connection: Database,
    metadata: map[string, domain.NpcMetadata],
    seen: map[string, bool],
) -> list[domain.Dialog]:
    statement = """
SELECT speaker_id, fallback_name, quest_id, bt_id, Text, Text1, dialog_type FROM (
 SELECT COALESCE(CAST(ct.Entry AS CHAR), '') AS speaker_id,
        COALESCE(ct.Name, CASE WHEN st.comment IS NOT NULL THEN SUBSTRING_INDEX(REPLACE(st.comment, '_', ' '), ' ', 1) ELSE 'Unknown' END) AS fallback_name,
        '' AS quest_id, CAST(st.broadcast_text_id AS CHAR) AS bt_id,
        st.content_default AS Text, '' AS Text1, 'gossip' AS dialog_type
 FROM script_texts st LEFT JOIN creature_template ct ON ct.ScriptName IS NOT NULL AND st.comment LIKE CONCAT(LOWER(REPLACE(ct.Name, ' ', '_')), '%')
 WHERE st.entry < 0 AND st.content_default IS NOT NULL AND st.content_default != ''
 UNION ALL
 SELECT CAST(CASE WHEN d.buddy_entry > 0 THEN d.buddy_entry ELSE d.id END AS CHAR), 'Unknown', '', CAST(d.dataint AS CHAR), bt.Text, bt.Text1, 'gossip'
 FROM dbscripts_on_creature_death d JOIN broadcast_text bt ON bt.Id=d.dataint WHERE d.command=0 AND bt.Id>0
 UNION ALL
 SELECT CAST(CASE WHEN d.buddy_entry > 0 THEN d.buddy_entry ELSE FLOOR(d.id/100) END AS CHAR), 'Unknown', '', CAST(d.dataint AS CHAR), bt.Text, bt.Text1, 'gossip'
 FROM dbscripts_on_creature_movement d JOIN broadcast_text bt ON bt.Id=d.dataint WHERE d.command=0 AND bt.Id>0
 UNION ALL
 SELECT '', 'Unknown_relaydb', '', CAST(d.dataint AS CHAR), bt.Text, bt.Text1, 'gossip'
 FROM dbscripts_on_relay d JOIN broadcast_text bt ON bt.Id=d.dataint WHERE d.command=0 AND bt.Id>0
 UNION ALL
 SELECT CAST(cqr.id AS CHAR), 'Unknown_quest_start', CAST(qt.entry AS CHAR), CAST(bt.Id AS CHAR), bt.Text, bt.Text1, 'quest_accept'
 FROM dbscripts_on_quest_start d JOIN broadcast_text bt ON bt.Id=d.dataint JOIN quest_template qt ON qt.StartScript=d.id JOIN creature_questrelation cqr ON cqr.quest=qt.entry WHERE d.command=0 AND bt.Id>0
 UNION ALL
 SELECT CAST(cir.id AS CHAR), 'Unknown_dbscripts_quest_end', CAST(qt.entry AS CHAR), CAST(bt.Id AS CHAR), bt.Text, bt.Text1, 'quest_complete'
 FROM dbscripts_on_quest_end d JOIN broadcast_text bt ON bt.Id=d.dataint JOIN quest_template qt ON qt.CompleteScript=d.id JOIN creature_involvedrelation cir ON cir.quest=qt.entry WHERE d.command=0 AND bt.Id>0
 UNION ALL
 SELECT COALESCE(CAST(CASE WHEN d.buddy_entry>0 THEN d.buddy_entry ELSE ct.Entry END AS CHAR), ''), 'Unknown_dbscripts_gossip', '', CAST(d.dataint AS CHAR), bt.Text, bt.Text1, 'gossip'
 FROM gossip_menu_option gmo JOIN dbscripts_on_gossip d ON d.id=gmo.action_script_id JOIN broadcast_text bt ON bt.Id=d.dataint LEFT JOIN creature_template ct ON ct.GossipMenuId=gmo.menu_id WHERE d.command=0 AND bt.Id>0 AND gmo.action_script_id>0
 UNION ALL
 SELECT COALESCE(CAST(d.buddy_entry AS CHAR), ''), 'Unknown_dbscripts_misc', '', CAST(d.dataint AS CHAR), bt.Text, bt.Text1, 'gossip'
 FROM dbscripts_on_event d JOIN broadcast_text bt ON bt.Id=d.dataint WHERE d.command=0 AND bt.Id>0
 UNION ALL
 SELECT COALESCE(CAST(d.buddy_entry AS CHAR), ''), COALESCE(got.name, 'Unknown_dbscripts_misc'), '', CAST(d.dataint AS CHAR), bt.Text, bt.Text1, 'gossip'
 FROM dbscripts_on_go_template_use d JOIN broadcast_text bt ON bt.Id=d.dataint LEFT JOIN gameobject_template got ON got.entry=d.id WHERE d.command=0 AND bt.Id>0
 UNION ALL
 SELECT COALESCE(CAST(d.buddy_entry AS CHAR), ''), COALESCE(got.name, 'Unknown_dbscripts_misc'), '', CAST(d.dataint AS CHAR), bt.Text, bt.Text1, 'gossip'
 FROM dbscripts_on_go_use d JOIN broadcast_text bt ON bt.Id=d.dataint LEFT JOIN gameobject go ON go.guid=d.id LEFT JOIN gameobject_template got ON got.entry=go.id WHERE d.command=0 AND bt.Id>0
 UNION ALL
 SELECT CAST(cas.creature_id AS CHAR), 'Unknown_ai_scripts', '', CAST(bt.Id AS CHAR), bt.Text, bt.Text1, 'gossip'
 FROM creature_ai_scripts cas JOIN broadcast_text bt ON ((cas.action1_type=1 AND bt.Id=cas.action1_param1) OR (cas.action2_type=1 AND bt.Id=cas.action2_param1) OR (cas.action3_type=1 AND bt.Id=cas.action3_param3)) WHERE bt.Id>0
 UNION ALL
 SELECT COALESCE(CAST(ds.buddy_entry AS CHAR), ''), 'Unknown_spell', '', CAST(ds.dataint AS CHAR), bt.Text, bt.Text1, 'gossip'
 FROM dbscripts_on_spell ds JOIN broadcast_text bt ON bt.Id=ds.dataint WHERE ds.command=0 AND bt.Id>0
) sources
"""
    output := []
    for row in query_or_empty(connection, statement):
        if size(row) < 7:
            continue
        text = choose_text(row[4], row[5])
        if size(text) == 0:
            continue
        npc = known_npc(metadata, row[0], row[1])
        output.append(make_dialog(npc.name if size(npc.name) > 0 else row[1], npc.sex, row[6], row[2], text))
        if size(row[3]) > 0:
            seen[row[3]] = true
    return output

def extract_gossip_menu_text(
    connection: Database,
    metadata: map[string, domain.NpcMetadata],
    seen: map[string, bool],
) -> list[domain.Dialog]:
    statement = """
WITH RECURSIVE menu_tree AS (
 SELECT gm.entry AS start_menu, gm.entry AS menu_id, 0 AS depth FROM gossip_menu gm
 UNION DISTINCT
 SELECT mt.start_menu, gmo.menu_id, mt.depth + 1 FROM menu_tree mt
 JOIN gossip_menu_option gmo ON gmo.action_menu_id=mt.menu_id
 WHERE mt.depth < 10 AND gmo.action_menu_id NOT IN (0,-1)
), owners AS (
 SELECT mt.start_menu, mt.depth, CAST(ct.Entry AS CHAR) owner_id, ct.Name owner_name, 'gossip' dialog_type
 FROM menu_tree mt JOIN creature_template ct ON ct.GossipMenuId=mt.menu_id
 UNION ALL
 SELECT mt.start_menu, mt.depth, '', got.name, 'item_text'
 FROM menu_tree mt JOIN gameobject_template got ON got.data3=mt.menu_id
), closest AS (SELECT start_menu, MIN(depth) depth FROM owners GROUP BY start_menu)
SELECT COALESCE(o.owner_id,''), COALESCE(o.owner_name,'Unknown_gossip_menu'), CAST(bt.Id AS CHAR), bt.Text, bt.Text1, COALESCE(o.dialog_type,'gossip')
FROM gossip_menu gm
JOIN npc_text_broadcast_text ntbt ON ntbt.Id=gm.text_id
JOIN broadcast_text bt ON bt.Id IN (ntbt.BroadcastTextId0,ntbt.BroadcastTextId1,ntbt.BroadcastTextId2,ntbt.BroadcastTextId3,ntbt.BroadcastTextId4,ntbt.BroadcastTextId5,ntbt.BroadcastTextId6,ntbt.BroadcastTextId7)
LEFT JOIN closest c ON c.start_menu=gm.entry
LEFT JOIN owners o ON o.start_menu=gm.entry AND o.depth=c.depth
WHERE bt.Id>0
"""
    output := []
    for row in query_or_empty(connection, statement):
        if size(row) < 6:
            continue
        text = choose_text(row[3], row[4])
        if size(text) == 0:
            continue
        npc = known_npc(metadata, row[0], row[1])
        output.append(make_dialog(npc.name if size(npc.name) > 0 else row[1], npc.sex, row[5], "", text))
        seen[row[2]] = true
    return output

def extract_page_text(connection: Database) -> list[domain.Dialog]:
    statement = """
WITH RECURSIVE pages AS (
 SELECT 'gameobject' source, CAST(got.entry AS CHAR) source_id, got.name source_name, '' quest_id, pt.entry page_id, pt.text, pt.next_page, 0 depth
 FROM gameobject_template got JOIN page_text pt ON pt.entry=got.data0 WHERE got.type=9 AND got.data0 IS NOT NULL
 UNION ALL
 SELECT p.source,p.source_id,p.source_name,p.quest_id,pt.entry,pt.text,pt.next_page,p.depth+1 FROM pages p JOIN page_text pt ON pt.entry=p.next_page WHERE p.next_page<>0 AND p.depth<100
), item_pages AS (
 SELECT 'item' source, CAST(it.entry AS CHAR), it.name, CAST(it.startquest AS CHAR), pt.entry, pt.text, pt.next_page, 0 depth
 FROM item_template it JOIN page_text pt ON pt.entry=it.PageText WHERE it.PageText IS NOT NULL
 UNION ALL
 SELECT p.source,p.source_id,p.source_name,p.quest_id,pt.entry,pt.text,pt.next_page,p.depth+1 FROM item_pages p JOIN page_text pt ON pt.entry=p.next_page WHERE p.next_page<>0 AND p.depth<100
)
SELECT source_name,quest_id,text FROM pages UNION ALL SELECT source_name,quest_id,text FROM item_pages
"""
    output := []
    for row in query_or_empty(connection, statement):
        if size(row) >= 3 and is_clean_text(row[2]):
            output.append(make_dialog(row[0], "", "item_text", row[1], row[2]))
    return output

def extract_greetings_and_quests(connection: Database, metadata: map[string, domain.NpcMetadata]) -> list[domain.Dialog]:
    statement = """
SELECT CAST(Entry AS CHAR), '', 'gossip', Text FROM questgiver_greeting
UNION ALL SELECT CAST(Entry AS CHAR), '', 'gossip', Text FROM trainer_greeting
UNION ALL SELECT CAST(cqr.id AS CHAR), CAST(qt.entry AS CHAR), 'quest_accept', qt.Details FROM quest_template qt JOIN creature_questrelation cqr ON cqr.quest=qt.entry
UNION ALL SELECT CAST(cqr.id AS CHAR), CAST(qt.entry AS CHAR), 'quest_progress', qt.RequestItemsText FROM quest_template qt JOIN creature_questrelation cqr ON cqr.quest=qt.entry
UNION ALL SELECT CAST(cir.id AS CHAR), CAST(qt.entry AS CHAR), 'quest_complete', qt.OfferRewardText FROM quest_template qt JOIN creature_involvedrelation cir ON cir.quest=qt.entry
UNION ALL SELECT CAST(cqr.id AS CHAR), CAST(qt.entry AS CHAR), 'quest_objective', qt.Objectives FROM quest_template qt JOIN creature_questrelation cqr ON cqr.quest=qt.entry
"""
    output := []
    for row in query_or_empty(connection, statement):
        if size(row) < 4 or not is_clean_text(row[3]):
            continue
        npc = known_npc(metadata, row[0], "")
        if size(npc.name) > 0:
            output.append(make_dialog(npc.name, npc.sex, row[2], row[1], row[3]))
    return output

def extract_orphan_broadcast_text(connection: Database, seen: map[string, bool]) -> list[domain.Dialog]:
    output := []
    for row in query_or_empty(connection, "SELECT CAST(Id AS CHAR),Text,Text1 FROM broadcast_text WHERE Id>0"):
        if size(row) >= 3 and not seen.get(row[0], false):
            text = choose_text(row[1], row[2])
            if size(text) > 0:
                output.append(make_dialog("Unknown_broadcast", "", "gossip", "", text))
    return output

def dialog_key(row: domain.Dialog) -> string:
    return row.npc_name + "|" + row.sex + "|" + row.dialog_type + "|" + row.quest_id + "|" + row.text

def separate_rows(rows: list[domain.Dialog]) -> tuple[list[domain.Dialog], list[domain.Dialog]]:
    table = dialog_data.from_dialogs(rows)
    unknown = table.filter(|record| size(record.get("npc_name")) == 0 or record.get("npc_name").starts_with("Unknown")).unique(["text"])
    known = table.filter(|record| size(record.get("npc_name")) > 0 and not record.get("npc_name").starts_with("Unknown")).unique(["npc_name", "sex", "dialog_type", "quest_id", "text"])
    return (dialog_data.dialogs(known), dialog_data.dialogs(unknown))

def csv_contents(rows: list[domain.Dialog]) -> string:
    return csv.CSV("", dialog_data.from_dialogs(rows).records()).encode()

def parse_dialog_rows(rows: list[list[string]]) -> list[domain.Dialog]:
    output := []
    table = csv.CSV("", rows).data().require_columns(dialog_data.columns())
    for row in table.where_not_empty("text").rows():
        output.append(dialog_data.to_dialog(row))
    return output

def detect_regressions(old_rows: list[domain.Dialog], new_rows: list[domain.Dialog]) -> list[string]:
    new_keys := {}
    for row in new_rows:
        new_keys[dialog_key(row)] = true
    missing := []
    for row in old_rows:
        key = dialog_key(row)
        if not new_keys.get(key, false):
            missing.append(key)
    return missing

def extract_all_dialog(config: domain.ExtractionConfig) -> Result[list[domain.Dialog], DatabaseError]:
    connection ?= mysql.connect(config.host, config.user, config.password, config.database, config.port)
    metadata = npc_metadata(connection)
    seen := {}
    all_rows := extract_attributed_broadcasts(connection, metadata, seen)
    all_rows.extend(extract_gossip_menu_text(connection, metadata, seen))
    all_rows.extend(extract_page_text(connection))
    all_rows.extend(extract_greetings_and_quests(connection, metadata))
    all_rows.extend(extract_orphan_broadcast_text(connection, seen))
    known, unknown = separate_rows(all_rows)
    if size(unknown) > 0:
        _directory = os.mkdir(path.dirname(config.investigation_csv))
        _written = write_text(config.investigation_csv, csv_contents(unknown))
    old_rows := []
    if os.exists(config.output_csv):
        loaded_file = file.read(config.output_csv)
        rows: list[list[string]] = loaded_file.value()
        old_rows = parse_dialog_rows(rows)
    regressions = detect_regressions(old_rows, known)
    if size(regressions) > 0:
        _closed = mysql.close(connection)
        return failure(DatabaseError("dialog regression: " + string(size(regressions)) + " prior rows are missing"))
    _directory = os.mkdir(path.dirname(config.output_csv))
    switch write_text(config.output_csv, csv_contents(known)):
        ok:
            _closed = mysql.close(connection)
            return known
        failure error:
            _closed = mysql.close(connection)
            return failure(DatabaseError(error.message))

test "clean text and fallback selection match extraction policy":
    assert(is_clean_text("For the Horde!"))
    assert(not is_clean_text("The guard dies."))
    assert(choose_text("begins to cast", "A clean alternate") == "A clean alternate")

test "CSV round trip and strict regression detection preserve source of truth":
    rows = [make_dialog("Thrall", "0", "gossip", "", "Honor, hero."), make_dialog("Unknown_spell", "", "gossip", "", "Mystery")]
    csv_file = csv.document(csv_contents(rows))
    parsed_rows: list[list[string]] = csv_file.value()
    parsed = parse_dialog_rows(parsed_rows)
    assert(size(parsed) == 2)
    typed: data.Data = dialog_data.from_dialogs(parsed)
    assert(typed.filter(|record| size(record.get("text")) > 0).row_count() == 2)
    known, unknown = separate_rows(parsed)
    assert(size(known) == 1)
    assert(size(unknown) == 1)
    assert(size(detect_regressions(known, [])) == 1)
    assert(size(detect_regressions(known, known)) == 0)
