import data
import "src/domain.sev" as domain

def columns() -> list[string]:
    return ["npc_name", "sex", "zone", "expansion", "client_version", "dialog_type", "quest_id", "text"]

def key_columns() -> list[string]:
    return ["npc_name", "dialog_type", "quest_id", "text", "zone", "expansion"]

def normalize_key(column: string, value: Any) -> Any:
    normalized = value.strip()
    return normalized.lower() if column == "expansion" else normalized

def row(value: domain.Dialog) -> data.Row:
    return data.Row(columns(), [
        value.npc_name,
        value.sex,
        value.zone,
        value.expansion,
        value.client_version,
        value.dialog_type,
        value.quest_id,
        value.text,
    ])

def to_dialog(row: data.Row) -> domain.Dialog:
    return domain.dialog(
        row.get("npc_name").strip(),
        row.get("sex").strip(),
        row.get("zone").strip(),
        row.get("expansion").strip(),
        row.get("client_version").strip(),
        row.get("dialog_type").strip(),
        row.get("quest_id").strip(),
        row.get("text").strip(),
    )

def from_dialogs(values: list[domain.Dialog]) -> data.Data:
    table := data.Data(columns(), [])
    for value in values:
        table.append_row(row(value))
    return table

def dialogs(table: data.Data) -> list[domain.Dialog]:
    values := []
    for row in table.rows():
        values.append(to_dialog(row))
    return values

def merge_columns() -> list[string]:
    return ["npc_name", "sex", "zone", "expansion", "client_version", "dialog_type", "quest_id"]

def merge_text_group(group: data.Data) -> data.Row:
    seen := {}
    texts := []
    for record in group.rows():
        text = record.get("text").strip()
        if not seen.get(text, false):
            texts.append(text)
            seen[text] = true
    combined := to_dialog(group.rows()[0])
    combined.text = texts.join(" ")
    return row(combined)

def merge_text_rows(values: list[domain.Dialog], dialog_types: list[string]) -> list[domain.Dialog]:
    normalized_types := []
    for dialog_type in dialog_types:
        normalized_types.append(dialog_type.strip().lower())
    table = from_dialogs(values).filter(
        |record| not (
            record.get("dialog_type").strip().lower() in normalized_types
            and size(record.get("text").strip()) == 0
        )
    )
    merged = table.group_merge(
        |record| record.get("dialog_type").strip().lower() in normalized_types,
        merge_columns(),
        |group| merge_text_group(group),
    )
    return dialogs(merged)

test "dialog tables group and merge selected text types in source order":
    rows = [
        domain.Dialog("Book", "", "", "vanilla", "", "item_text", "", "Page one.", "", false, ""),
        domain.Dialog("Guard", "", "", "vanilla", "", "gossip", "", "Halt!", "", false, ""),
        domain.Dialog("Book", "", "", "vanilla", "", "item_text", "", "Page two.", "", false, ""),
    ]
    merged = merge_text_rows(rows, ["item_text"])
    assert(size(merged) == 2)
    assert(merged[0].text == "Page one. Page two.")
    assert(merged[1].npc_name == "Guard")

test "dialog text merging scopes uniqueness and metadata to each group":
    rows = [
        domain.Dialog("Book", "", "Durotar", "vanilla", "1.12.1", "item_text", "1", "Shared.", "", false, ""),
        domain.Dialog("Letter", "", "Durotar", "vanilla", "1.12.1", "item_text", "2", "Shared.", "", false, ""),
        domain.Dialog("Book", "", "Durotar", "vanilla", "1.12.1", "item_text", "1", "Continued.", "", false, ""),
        domain.Dialog("Book", "", "Elwynn", "vanilla", "1.12.1", "item_text", "1", "Other zone.", "", false, ""),
    ]
    merged = merge_text_rows(rows, [" ITEM_TEXT "])
    assert(size(merged) == 3)
    assert(merged[0].text == "Shared. Continued.")
    assert(merged[1].text == "Shared.")
    assert(merged[2].text == "Other zone.")
