class Dialog:
    npc_name: string
    sex: string
    zone: string
    expansion: string
    client_version: string
    dialog_type: string
    quest_id: string
    text: string
    model_id: string
    skip_generation: bool
    link_to_npc: string

class NpcMetadata:
    name: string
    race: string
    sex: string
    zone: string
    model_id: string

class LuaDialog:
    path: string
    dialog_type: string
    quest_id: string
    seconds: float
    linked_to: string

class LuaNpc:
    race: string
    sex: string
    portrait: string
    zone: string
    model_id: string
    narrator: string
    dialogs: map[string, LuaDialog]

class DatabaseConfig:
    npc_metadata_json: string
    race_file: string
    sex_file: string
    zone_file: string
    missing_race_file: string
    output_lua: string
    sounds_directory: string

class ExtractionConfig:
    host: string
    user: string
    password: string
    database: string
    port: int
    output_csv: string
    investigation_csv: string

class ReferenceCode:
    name: string
    audio_path: string

class AudioTarget:
    path: string
    narrator: string
    dialog_type: string
    quest_id: string
    has_quest_id: bool

class GenerationOptions:
    sounds_directory: string
    narrator_override: string
    regenerate: bool
    cutoff_seconds: float
    incremental_sync: bool
    max_retries: int
    retry_wait: int
    database: DatabaseConfig

class GenerationRequest:
    text: string
    audio_prompt_path: string

class AudioSamples:
    samples: list[float]
    sample_rate: int

class GenerationResult:
    path: string
    status: string
    message: string

class PipelineReport:
    source_rows: int
    filtered_rows: int
    generated_rows: int
    new_rows: int
    status: int

class CliOptions:
    race: string
    sex: string
    npc: string
    zones: list[string]
    expansions: list[string]
    dialog_type: string
    narrator: string
    limit: int
    regenerate: bool
    time_cutoff: string
    device: string
    tts_model: string
    tts_language: string
    tts_steps: int
    tts_speed: float
    asr_model: string
    skip_sync: bool
    skip_audio: bool
    skip_metadata: bool
    gpu_threshold: float
    gpu_wait: int
    gpu_check_interval: int
    max_retries: int
    retry_wait: int
    daemon: bool
    daemon_interval: int
    wtf_path: string

def dialog(
    npc_name: string,
    sex: string,
    zone: string,
    expansion: string,
    client_version: string,
    dialog_type: string,
    quest_id: string,
    text: string,
) -> Dialog:
    return Dialog(
        npc_name,
        sex,
        zone,
        expansion,
        client_version,
        dialog_type,
        quest_id,
        text,
        "",
        false,
        "",
    )

def copy_dialog(row: Dialog) -> Dialog:
    return Dialog(
        row.npc_name,
        row.sex,
        row.zone,
        row.expansion,
        row.client_version,
        row.dialog_type,
        row.quest_id,
        row.text,
        row.model_id,
        row.skip_generation,
        row.link_to_npc,
    )

test "dialog rows retain optional pipeline state":
    row = dialog("Thrall", "0", "Durotar", "vanilla", "1.12.1", "gossip", "", "Lok'tar")
    assert(row.npc_name == "Thrall")
    assert(not row.skip_generation)
    assert(row.link_to_npc == "")
